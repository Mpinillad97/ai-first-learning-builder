# Copy to server/.env and fill in. server/.env is git-ignored and loaded automatically at startup;
# variables already set in the shell take precedence over this file.

# HTTP port of the API (default 3001).
PORT=3001

# Required for AI claim analysis. Server-side only: never expose it to the client.
# Without it, POST /api/documents/:id/analyses responds 503.
OPENAI_API_KEY=

# Model used for claim extraction (must support structured outputs). Default: gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini

# Request timeout in milliseconds for each AI call (default 120000).
OPENAI_TIMEOUT_MS=120000

# Optional: alternative API base URL (e.g. a proxy or a local test server). Leave empty for the official API.
OPENAI_BASE_URL=
